{
  "name": "mi-app-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently \"npm run build -- --watch\" \"nodemon --watch app.js --watch server.js --watch website --watch configs server.js\"",
    "start": "node server.js",
    "build": "node scripts/build.js",
    "db:new": "dbmate --env-file .env -d db/migrations -e DB new",
    "db:up": "dbmate --env-file .env --no-dump-schema -d db/migrations -e DB up",
    "db:rollback": "dbmate --env-file .env --no-dump-schema -d db/migrations -e DB rollback",
    "db:seed": "node scripts/seed.js",
    "configure": "node scripts/configure.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "recovery:link": "node scripts/recovery.js",
    "docs:model": "node scripts/model.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "vercel:env": "node scripts/vercel-env.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "morgan": "^1.10.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "sequelize": "^6.37.8",
    "session-file-store": "^1.5.0",
    "bcryptjs": "3.0.2",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "dbmate": "^2.26.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "nodemon": "^3.1.14",
    "react-toastify": "^11.1.0",
    "vite": "^5.2.0",
    "supertest": "7.1.4"
  }
}
