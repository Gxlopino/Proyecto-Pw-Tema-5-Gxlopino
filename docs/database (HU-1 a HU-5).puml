categorias }o--|| prioridades : "prioridad_defecto → codigo"
especialidades_declaradas }o--|| categorias : "categoria_id → id ON DELETE CASCADE"
especialidades_declaradas }o--|| usuarios : "usuario_id → id ON DELETE CASCADE"
esperas_ticket }o--|| tickets : "ticket_id → id ON DELETE CASCADE"
historial_estados }o--|| usuarios : "autor_id → id ON DELETE RESTRICT"
historial_estados }o--o| estados_ticket : "estado_anterior → codigo"
historial_estados }o--|| estados_ticket : "estado_nuevo → codigo"
historial_estados }o--|| tickets : "ticket_id → id ON DELETE CASCADE"
invitaciones }o--|| usuarios : "invitado_por_id → id ON DELETE RESTRICT"
reaperturas }o--|| usuarios : "autor_id → id ON DELETE RESTRICT"
reaperturas }o--|| tickets : "ticket_id → id ON DELETE CASCADE"
tecnicos_categorias }o--|| categorias : "categoria_id → id ON DELETE CASCADE"
tecnicos_categorias }o--|| usuarios : "tecnico_id → id ON DELETE CASCADE"
tickets }o--|| ambientes : "ambiente_id → id ON DELETE RESTRICT"
tickets }o--|| categorias : "categoria_id → id ON DELETE RESTRICT"
tickets }o--|| estados_ticket : "estado → codigo"
tickets }o--|| prioridades : "prioridad → codigo"
tickets }o--|| prioridades : "prioridad_sugerida → codigo"
tickets }o--|| usuarios : "solicitante_id → id ON DELETE RESTRICT"
tickets }o--|| categorias : "subcategoria_id → id ON DELETE RESTRICT"
tickets }o--|| categorias : "subcategoria_id, categoria_id → id, parent_id ON DELETE RESTRICT"
tickets }o--o| usuarios : "tecnico_id → id ON DELETE RESTRICT"
tickets_cierres }o--|| tickets : "ticket_id → id ON DELETE CASCADE"
tokens_recuperacion }o--|| usuarios : "usuario_id → id ON DELETE CASCADE"
usuarios }o--o| ambientes : "ambiente_habitual_id → id ON DELETE SET NULL"
usuarios }o--o| unidades : "unidad_id → id ON DELETE SET NULL"
note "Fechas: timestamptz, UTC en almacenamiento; America/Lima en UI.\nCatálogos con códigos únicos: FK natural para estado/prioridad.\nCategorías: dos niveles; FK compuesta valida subcategoría y padre.\nRLS sin políticas públicas: acceso exclusivo por Express.\nSesiones persistidas; tokens almacenados mediante SHA-256.\nÍndices, CHECK y defaults completos: docs/modelo-validado.json." as reglas
