' docs/database (HU-1 a HU-5).puml
@startuml db_model
 hide methods
skinparam linetype ortho
skinparam shadowing false
entity "ambientes" as ambientes {
  * id : integer PK, NOT NULL
  sede_id : integer FK, NOT NULL
  codigo : character varying(15) UQ, NOT NULL
  tipo : character varying(20) NOT NULL
  nombre : character varying(60) NOT NULL
  pabellon : character varying(30) NOT NULL
  piso : integer NOT NULL
  capacidad : integer NOT NULL
  activo : boolean NOT NULL
}
entity "asignaciones" as asignaciones {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  tecnico_id : integer FK, NULL
  asignado_por_id : integer FK, NOT NULL
  tipo : character varying(20) NOT NULL
  motivo : character varying(240) NULL
  nota : text NULL
  creado_en : timestamp with time zone NOT NULL
}
entity "bitacora_entradas" as bitacora_entradas {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  autor_id : integer FK, NOT NULL
  tipo : character varying(10) NOT NULL
  texto : character varying(600) NOT NULL
  creado_en : timestamp with time zone NOT NULL
}
entity "cambios_prioridad" as cambios_prioridad {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  anterior : character varying(10) FK, NOT NULL
  nueva : character varying(10) FK, NOT NULL
  motivo : character varying(240) NOT NULL
  autor_id : integer FK, NOT NULL
  creado_en : timestamp with time zone NOT NULL
}
entity "categorias" as categorias {
  * id : integer PK, NOT NULL
  nombre : character varying(60) NOT NULL
  parent_id : integer FK, NULL
  prioridad_defecto : character varying(10) FK, NOT NULL
  tiempo_esperado_horas : integer NOT NULL
  descripcion : character varying(240) NOT NULL
  activa : boolean NOT NULL
  creada_en : timestamp with time zone NOT NULL
}
entity "especialidades_declaradas" as especialidades_declaradas {
  * id : integer PK, NOT NULL
  usuario_id : integer FK, NOT NULL
  categoria_id : integer FK, NOT NULL
}
entity "esperas_ticket" as esperas_ticket {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  motivo : text NOT NULL
  fecha_retorno : timestamp with time zone NOT NULL
  inicio_en : timestamp with time zone NOT NULL
  fin_en : timestamp with time zone NULL
}
entity "estados_ticket" as estados_ticket {
  * id : integer PK, NOT NULL
  codigo : character varying(15) UQ, NOT NULL
  nombre : character varying(30) NOT NULL
  color : character varying(7) NOT NULL
  es_final : boolean NOT NULL
}
entity "historial_estados" as historial_estados {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  estado_anterior : character varying(15) FK, NULL
  estado_nuevo : character varying(15) FK, NOT NULL
  autor_id : integer FK, NOT NULL
  motivo : text NULL
  permanencia_min : integer NOT NULL
  creado_en : timestamp with time zone NOT NULL
}
entity "invitaciones" as invitaciones {
  * id : integer PK, NOT NULL
  nombres : character varying(60) NOT NULL
  apellidos : character varying(60) NOT NULL
  email : character varying(100) NOT NULL
  rol : character varying(15) NOT NULL
  token_hash : character varying(64) UQ, NOT NULL
  invitado_por_id : integer FK, NOT NULL
  estado : character varying(15) NOT NULL
  creada_en : timestamp with time zone NOT NULL
  vence_en : timestamp with time zone NOT NULL
  aceptada_en : timestamp with time zone NULL
}
entity "prioridades" as prioridades {
  * id : integer PK, NOT NULL
  codigo : character varying(10) UQ, NOT NULL
  nombre : character varying(20) NOT NULL
  orden : integer UQ, NOT NULL
  color : character varying(7) NOT NULL
  horas : integer NOT NULL
}
entity "reaperturas" as reaperturas {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, NOT NULL
  autor_id : integer FK, NOT NULL
  motivo : text NOT NULL
  creado_en : timestamp with time zone NOT NULL
}
entity "sedes" as sedes {
  * id : integer PK, NOT NULL
  nombre : character varying(60) UQ, NOT NULL
  direccion : character varying(120) NOT NULL
  activa : boolean NOT NULL
}
entity "sesiones" as sesiones {
  * sid : character varying PK, NOT NULL
  sess : json NOT NULL
  expire : timestamp without time zone NOT NULL
}
entity "tecnicos_categorias" as tecnicos_categorias {
  * id : integer PK, NOT NULL
  tecnico_id : integer FK, NOT NULL
  categoria_id : integer FK, NOT NULL
  habilitado_en : timestamp with time zone NOT NULL
}
entity "tickets" as tickets {
  * id : integer PK, NOT NULL
  codigo : character varying(24) UQ, NOT NULL
  asunto : character varying(120) NOT NULL
  descripcion : character varying(600) NOT NULL
  categoria_id : integer FK, NOT NULL
  subcategoria_id : integer FK, NOT NULL
  ambiente_id : integer FK, NOT NULL
  solicitante_id : integer FK, NOT NULL
  tecnico_id : integer FK, NULL
  prioridad : character varying(10) FK, NOT NULL
  prioridad_sugerida : character varying(10) FK, NOT NULL
  estado : character varying(15) FK, NOT NULL
  creado_en : timestamp with time zone NOT NULL
  vence_en : timestamp with time zone NOT NULL
  tiempo_espera_min : integer NOT NULL
}
entity "tickets_cierres" as tickets_cierres {
  * id : integer PK, NOT NULL
  ticket_id : integer FK, UQ, NOT NULL
  solucion : text NULL
  resuelto_en : timestamp with time zone NOT NULL
  cerrado_en : timestamp with time zone NULL
  tiempo_atencion_min : integer NULL
}
entity "tokens_recuperacion" as tokens_recuperacion {
  * id : integer PK, NOT NULL
  usuario_id : integer FK, NOT NULL
  token_hash : character varying(64) UQ, NOT NULL
  creado_en : timestamp with time zone NOT NULL
  vence_en : timestamp with time zone NOT NULL
  usado_en : timestamp with time zone NULL
}
entity "unidades" as unidades {
  * id : integer PK, NOT NULL
  nombre : character varying(100) UQ, NOT NULL
}
entity "usuarios" as usuarios {
  * id : integer PK, NOT NULL
  nombres : character varying(60) NOT NULL
  apellidos : character varying(60) NOT NULL
  email : character varying(100) UQ, NOT NULL
  password_hash : character varying(100) NOT NULL
  telefono : character varying(15) NOT NULL
  unidad_id : integer FK, NULL
  vinculo : character varying(20) NOT NULL
  rol : character varying(15) NOT NULL
  estado : character varying(15) NOT NULL
  motivo_bloqueo : text NULL
  intentos_fallidos : integer NOT NULL
  bloqueado_hasta : timestamp with time zone NULL
  ambiente_habitual_id : integer FK, NULL
  creado_en : timestamp with time zone NOT NULL
  ultimo_acceso : timestamp with time zone NULL
  session_version : integer NOT NULL
}
ambientes }o--|| sedes : "sede_id → id ON DELETE RESTRICT"
asignaciones }o--|| usuarios : "asignado_por_id → id ON DELETE RESTRICT"
asignaciones }o--o| usuarios : "tecnico_id → id ON DELETE RESTRICT"
